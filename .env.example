# =============================================================================
# MemeBot Environment Configuration
# Copy to .env and adjust. Never commit real secrets.
# =============================================================================

# Runtime mode: "demo" (deterministic synthetic data) or "live" (real providers)
DATA_MODE=demo

# =============================================================================
# PAPER-ONLY SAFETY LOCK — do not enable real execution
# App REFUSES TO START if REAL_EXECUTION_ENABLED or WALLET_SIGNING_ENABLED is true.
# Adding real execution later requires an architectural change + security review.
# =============================================================================
TRADING_MODE=PAPER
REAL_EXECUTION_ENABLED=false
WALLET_SIGNING_ENABLED=false
REALISM_PROFILE=REALISTIC
REPLAY_SEED=42

# Server
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://memebot:memebot@localhost:5432/memebot
TEST_DATABASE_URL=postgresql://memebot:memebot@localhost:5432/memebot_test

# Default demo portfolio (no auth in MVP)
DEFAULT_PORTFOLIO_ID=00000000-0000-4000-8000-000000000001
INITIAL_BALANCE_USD=100.00

# Bot / worker intervals (ms)
JOB_TOKEN_DISCOVERY_INTERVAL_MS=15000
JOB_MARKET_DATA_INTERVAL_MS=10000
JOB_ONCHAIN_INTERVAL_MS=30000
JOB_SIGNAL_INTERVAL_MS=12000
JOB_PAPER_EXECUTION_INTERVAL_MS=8000
JOB_PORTFOLIO_VALUATION_INTERVAL_MS=10000
JOB_ANALYTICS_INTERVAL_MS=30000
JOB_TRADE_STREAM_INTERVAL_MS=5000
JOB_SHADOW_INTERVAL_MS=15000
JOB_REGIME_INTERVAL_MS=30000
CAUTION_DRAWDOWN_PCT=0.1
RECOVERY_DRAWDOWN_PCT=0.08
MIN_EXPECTED_NET_VALUE=0.02
DEFAULT_JITO_TIP_LAMPORTS=10000

# Provisional research EV config — NOT a calibrated probability model.
# Threshold = MIN_EXPECTED_NET_VALUE (MEDIUM/HIGH measured data confidence)
#           = MIN_EXPECTED_NET_VALUE * LOW_CONFIDENCE_EV_MULTIPLIER (LOW/UNKNOWN)
LOW_CONFIDENCE_EV_MULTIPLIER=1.2

# Token universe: tracking set (retention) vs per-tick compute/API budgets
TOKEN_TRACKING_MAX_AGE_HOURS=24
TOKEN_TRACKING_CAP=5000
TOKEN_EVALUATION_CAP_PER_TICK=200
# Share of the evaluation budget reserved for least-recently-evaluated tokens
TOKEN_EVALUATION_ROTATION_SHARE=0.25
# DexScreener batches 30 addresses/request; 300 tokens = 10 requests per tick
MARKET_DATA_CAP_PER_TICK=300
TOKEN_STALE_AFTER_SEC=300
TOKEN_ARCHIVE_STALE_AFTER_MIN=30
JOB_LIFECYCLE_INTERVAL_MS=15000
JOB_OPPORTUNITY_INTERVAL_MS=5000

# Volume acceleration (current 5m vs previous completed 5m)
VOLUME_ACCEL_MIN_BASELINE_USD=500
VOLUME_ACCEL_MAX=10

# Research paper portfolio — borderline EV trades, isolated from production stats.
# The daily limit is a maximum, not a quota.
RESEARCH_EXPLORATION_ENABLED=true
RESEARCH_MAX_TRADES_PER_DAY=5
RESEARCH_MAX_EV_SHORTFALL=0.015

# Shadow trades / opportunity recorder: one record per token+strategy per cooldown
SHADOW_REENTRY_COOLDOWN_SECONDS=300
# Risk sizing — provisional paper/research values. Uncertainty shrinks size; invalid data rejects.
# Base size = equity × MAX_POSITION_PCT, max planned loss = equity × MAX_RISK_PER_TRADE_PCT,
# max open positions = MAX_SIMULTANEOUS_POSITIONS (existing settings, not duplicated).
PAPER_MIN_POSITION_USD=1
MAX_PORTFOLIO_EXPOSURE_PCT=0.5
MAX_STRATEGY_EXPOSURE_PCT=0.25
MAX_TOKEN_EXPOSURE_PCT=0.1
RISK_SIZE_HIGH_MULTIPLIER=1.0
RISK_SIZE_MEDIUM_MULTIPLIER=0.6
RISK_SIZE_LOW_MULTIPLIER=0.3
RISK_STRONG_EV_MARGIN=0.03
RISK_SIZE_STRONG_EV_MULTIPLIER=1.25
RISK_SIZE_RESEARCH_MULTIPLIER=0.5
RISK_VOL_HIGH_PCT=15
RISK_VOL_VERY_HIGH_PCT=25
RISK_VOL_EXTREME_PCT=80
RISK_SIZE_HIGH_VOL_MULTIPLIER=0.75
RISK_SIZE_VERY_HIGH_VOL_MULTIPLIER=0.5
MAX_ENTRY_PRICE_IMPACT_PCT=3
MAX_ROUND_TRIP_COST_RATE=0.2
OPPORTUNITY_COOLDOWN_SECONDS=300
PUMPFUN_API_BASE_URL=https://frontend-api.pump.fun

# Paper-only alerts (disabled when unset)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
ALERT_EMAIL_TO=
ALERT_COOLDOWN_MS=300000

# Rate limiting
PROVIDER_MAX_RETRIES=3
PROVIDER_RETRY_BASE_MS=500
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300

# Solana / market data providers (optional for live mode)
# DexScreener is public (no key). GeckoTerminal is public.
# Birdeye / Jupiter / custom RPC may need keys.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
DEXSCREENER_BASE_URL=https://api.dexscreener.com
GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2
JUPITER_BASE_URL=https://quote-api.jup.ag/v6
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
BIRDEYE_API_KEY=
BIRDEYE_BASE_URL=https://public-api.birdeye.so

# Meteora DBC discovery (keyless). Optional dedicated RPC; falls back to SOLANA_RPC_URL.
METEORA_DBC_ENABLED=true
METEORA_DBC_DATAPI_ENABLED=true
METEORA_DBC_DATAPI_BASE_URL=https://dbc.datapi.meteora.ag
METEORA_DBC_REALTIME_ENABLED=false
METEORA_DBC_RPC_URL=
METEORA_DBC_SIGNATURE_LIMIT=25
METEORA_DBC_TX_FETCH_LIMIT=8
METEORA_DBC_MAX_PER_POLL=20
METEORA_DBC_DATAPI_PAGE_SIZE=40
METEORA_DBC_DATAPI_MAX_AGE_HOURS=48
# No real DBC init for this many minutes → STALE (launches are frequent on mainnet)
METEORA_DBC_STALE_SILENCE_MINUTES=30
STORAGE_SOFT_LIMIT_BYTES=450000000
# Hosted Postgres only (needs superuser): cap write-ahead log, e.g. 64MB on a 0.5GB volume
# DB_MAX_WAL_SIZE=64MB

# Fee simulation defaults (overridable; see README for formulas)
DEFAULT_PRIORITY_FEE_LAMPORTS=5000
# DEMO MODE ONLY — deterministic SOL/USD for fee conversion. Live mode never
# silently falls back to this for new paper trades; it fetches DexScreener WSOL
# (primary) then CoinGecko (fallback). Stale/unavailable SOL/USD blocks new trades.
DEFAULT_SOL_PRICE_USD=150
SOL_PRICE_CACHE_TTL_MS=30000
SOL_PRICE_MAX_STALE_MS=120000
FAILED_TX_STILL_CHARGES_NETWORK=true
STALE_PRICE_MAX_AGE_MS=60000

# Daily learning report (local wall-clock time in REPORT_TIMEZONE)
REPORT_TIME=23:55
REPORT_TIMEZONE=Asia/Dubai
# false = still write reports, but never change settings
LEARNING_ENABLED=true
# Closed trades needed in the 7-day window before any setting changes
LEARNING_MIN_TRADES=20
# Three-level learning (paper only):
#   Level 1 — every closed trade is stored as an immutable observation (no model change)
#   Level 2 — every N observations a health check flags anomalies (alerts only, no retraining)
#   Level 3 — calibration runs with the daily report, only when BOTH conditions hold
LEARNING_INTERVAL_HOURS=24
MIN_NEW_OBSERVATIONS_FOR_LEARNING=25
ANOMALY_CHECK_INTERVAL_TRADES=5
ANOMALY_RECENT_WINDOW_TRADES=25
ANOMALY_BASELINE_WINDOW_TRADES=100
ANOMALY_ALERT_COOLDOWN_MINUTES=60
# Week-1 observation mode: keep collecting evidence (observations, health checks, reports,
# calibration candidates) but never change strategy parameters or promote an EV calibration
# automatically. Set to false only after reviewing a week of clean data.
LEARNING_OBSERVATION_MODE=true

# Data retention
# HF raw (market/liquidity/holder snapshots, safety, feature_snapshots, trade_events): 3h
# Research raw (token_raw_feature_observations + compacted checkpoints): 72h
# Logs / missed_opportunities: 3 days
# Permanent: identity, discovery events, decision audits, decision feature snapshots,
# outcome summaries, trades, positions — never pruned.
RAW_DATA_RETENTION_HOURS=3
RESEARCH_DATA_RETENTION_HOURS=72
EVENT_RETENTION_DAYS=3

# Risk defaults
MAX_POSITION_PCT=0.05
MAX_SIMULTANEOUS_POSITIONS=5
MAX_RISK_PER_TRADE_PCT=0.01
MAX_DAILY_LOSS_PCT=0.05
MAX_DRAWDOWN_PCT=0.15
