# =============================================================================
# MemeBot Environment Configuration
# Copy to .env and adjust. Never commit real secrets.
# =============================================================================

# Runtime mode: "demo" (deterministic synthetic data) or "live" (real providers)
DATA_MODE=demo

# Server
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://memebot:memebot@localhost:5432/memebot
TEST_DATABASE_URL=postgresql://memebot:memebot@localhost:5432/memebot_test

# Default demo portfolio (no auth in MVP)
DEFAULT_PORTFOLIO_ID=00000000-0000-4000-8000-000000000001
INITIAL_BALANCE_USD=100.00

# Bot / worker intervals (ms)
JOB_TOKEN_DISCOVERY_INTERVAL_MS=15000
JOB_MARKET_DATA_INTERVAL_MS=10000
JOB_ONCHAIN_INTERVAL_MS=30000
JOB_SIGNAL_INTERVAL_MS=12000
JOB_PAPER_EXECUTION_INTERVAL_MS=8000
JOB_PORTFOLIO_VALUATION_INTERVAL_MS=10000
JOB_ANALYTICS_INTERVAL_MS=30000

# Rate limiting
PROVIDER_MAX_RETRIES=3
PROVIDER_RETRY_BASE_MS=500
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300

# Solana / market data providers (optional for live mode)
# DexScreener is public (no key). GeckoTerminal is public.
# Birdeye / Jupiter / custom RPC may need keys.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
DEXSCREENER_BASE_URL=https://api.dexscreener.com
GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2
JUPITER_BASE_URL=https://quote-api.jup.ag/v6
BIRDEYE_API_KEY=
BIRDEYE_BASE_URL=https://public-api.birdeye.so

# Fee simulation defaults (overridable; see README for formulas)
DEFAULT_PRIORITY_FEE_LAMPORTS=5000
DEFAULT_SOL_PRICE_USD=150
FAILED_TX_STILL_CHARGES_NETWORK=true
STALE_PRICE_MAX_AGE_MS=60000

# Risk defaults
MAX_POSITION_PCT=0.05
MAX_SIMULTANEOUS_POSITIONS=5
MAX_RISK_PER_TRADE_PCT=0.01
MAX_DAILY_LOSS_PCT=0.05
MAX_DRAWDOWN_PCT=0.15
